# User OAuth token (xoxp-...). Reads and resolves use this, and so do sends
# when no bot token is set or the bot can't post there.
SLACK_USER_TOKEN=xoxp-...

# App-level token (xapp-...) with connections:write. Used by the Socket Mode
# listener to receive message events.
SLACK_APP_TOKEN=xapp-...

# Optional bot token (xoxb-...) from the same app. Sends and edits try it
# first, so they show up as the bot, and fall back to the user token where
# the bot can't post (DMs between people, group DMs, uninvited private channels).
# SLACK_BOT_TOKEN=xoxb-...

# Override the bot's name and icon on text posts (needs chat:write.customize).
# Unset uses the app's own name and icon. Slack ignores these on file uploads.
# SLACK_BOT_USERNAME=
# SLACK_BOT_ICON_URL=

# Footer under messages posted as you (a grey context line, like Slack's
# "Sent using Claude"). Default "*Sent using* <app name>", with the app name
# read through the bot token, or "AI" without one. Set to an empty string to
# disable, or override with your own Slack mrkdwn text.
# SLACK_SEND_FOOTER=*Sent using* L.E.O

# Folder of Claude Code transcripts that slack_delete reads to check that you
# typed the authorization sentence. Default: $CLAUDE_CONFIG_DIR/projects/<cwd
# folder>, or ~/.claude/projects/<cwd folder> without CLAUDE_CONFIG_DIR.
# SLACK_TRANSCRIPT_DIR=
